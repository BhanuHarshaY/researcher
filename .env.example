# Copy to .env and fill in. .env is gitignored; never commit it.
ANTHROPIC_API_KEY=

# Optional, only used by the dev-time corpus builder (corpus_tools/snapshot.py).
# A contact email puts requests in the OpenAlex/Crossref "polite" pools;
# the keys raise rate limits. Leave blank if you don't have them.
CONTACT_EMAIL=
OPENALEX_API_KEY=

